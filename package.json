{
  "name": "llm-wiki",
  "version": "0.0.0",
  "private": true,
  "description": "Skill-based local knowledge service",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "team-app"
  ],
  "scripts": {
    "dev": "npm run start -w @llm-wiki/team-app",
    "dev:server": "npm run dev",
    "dev:team": "npm run dev",
    "test": "npm run test:team && npm run test:collector",
    "test:team": "npm run test -w @llm-wiki/team-app",
    "quality-and-tests": "npm test",
    "test:collector": "node --test kb-system/collector/test/*.test.mjs kb-system/librarian/test/*.test.mjs"
  }
}
