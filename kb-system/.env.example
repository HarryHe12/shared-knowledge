# 企业微信官方应用配置，全部必填；不提供开发默认凭据。
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# 统一知识服务；远程仅限 HTTPS，本机可 HTTP。
KB_URL=http://127.0.0.1:5181
# 知识库组织页登记的 wecom 应用 ID（不是 AgentID）。
KB_CHANNEL_APP_ID=
# 至少24字符；与内核中该应用 secret_env 指向的环境变量值相同。
KB_CHANNEL_BRIDGE_KEY=

COLLECTOR_HOST=127.0.0.1
COLLECTOR_PORT=9100
# 不填默认 collector/.data/inbox.sqlite；生产推荐显式绝对路径。
COLLECTOR_DB=
COLLECTOR_MAX_ATTEMPTS=5
COLLECTOR_CONCURRENCY=4

# 以下仅兼容旧私人范围导出，默认关闭；不得用于公司范围。
KB_ENABLE_LEGACY_EXPORT=0
KB_SERVICE_TOKEN=
KB_SERVICE_SCOPE=

# 可选 Agent 网关附加密钥 name:key,...，不能替代员工 Bearer。
AGENT_API_KEYS=
